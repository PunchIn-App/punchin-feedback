{
  "name": "punchin-feedback",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Account-free bug-report / feature-request intake for PunchIn — derives forms from the GitHub issue templates, files issues via a GitHub App, hosts screenshots in R2, and emails reporters.",
  "license": "BUSL-1.1",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "wrangler deploy --dry-run",
    "sync-templates": "node scripts/sync-bundled.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.2.0",
    "postal-mime": "^2.7.5"
  },
  "devDependencies": {
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
